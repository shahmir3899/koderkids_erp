# =============================================================================
# KoderKids ERP Backend - Environment Variables
# =============================================================================
# Copy this file to .env and fill in your actual values:
#   cp .env.example .env
#
# NEVER commit .env to version control!
# =============================================================================

# ---------------------------------------------------------------------------
# Environment Toggle
# ---------------------------------------------------------------------------
# Set to "production" on the deployed server, "local" for development.
# This single variable controls: DEBUG, CORS_ALLOW_ALL_ORIGINS, FRONTEND_URL,
# NGROK_URL, EMAIL_BACKEND, and the LLM_PROVIDER default.
ENVIRONMENT=local

# ---------------------------------------------------------------------------
# Django Core
# ---------------------------------------------------------------------------
DJANGO_SECRET_KEY=change-me-to-a-random-50-char-string

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# PostgreSQL connection URL. Leave empty to fall back to backend/db.sqlite3 locally.
DATABASE_URL=

# ---------------------------------------------------------------------------
# Supabase (File Storage)
# ---------------------------------------------------------------------------
REACT_APP_SUPABASE_URL=https://your-project.supabase.co
REACT_APP_SUPABASE_SEC_KEY=your_supabase_service_role_key_here

# ---------------------------------------------------------------------------
# FRONTEND_URL / NGROK_URL
# ---------------------------------------------------------------------------
# Derived automatically from ENVIRONMENT in settings.py. Only set these to
# override the standard local/production URL.
#FRONTEND_URL=http://localhost:3000
#NGROK_URL=http://127.0.0.1:8000

# ---------------------------------------------------------------------------
# Email / SMTP (Hostnext cPanel)
# ---------------------------------------------------------------------------
# Local development uses the console backend automatically (emails print to
# the terminal instead of sending). Production uses SMTP automatically.
# Override with EMAIL_BACKEND here only if you need something else.
EMAIL_HOST=mail.koderkids.pk
EMAIL_PORT=465
EMAIL_USE_SSL=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=KoderKids ERP <admin@koderkids.pk>

# ---------------------------------------------------------------------------
# AI/LLM CONFIGURATION
# ---------------------------------------------------------------------------
# Provider preference: comma-separated list (first available will be used).
# Options: "ollama" (local), "groq" (cloud, free tier).
# Defaults based on ENVIRONMENT: "ollama,groq" locally, "groq" in production.
# Only set LLM_PROVIDER here to override that default.
#LLM_PROVIDER=ollama,groq
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=deepseek-coder:6.7b
# Get your free Groq API key at: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# ---------------------------------------------------------------------------
# WhatsApp (WAHA / n8n)
# ---------------------------------------------------------------------------
WHATSAPP_BOT_KEY=

# ---------------------------------------------------------------------------
# Online Classes (LiveKit)
# ---------------------------------------------------------------------------
# Free account at https://cloud.livekit.io
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
