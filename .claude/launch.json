{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "koderkids-backend",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "backend/manage.py",
        "runserver",
        "127.0.0.1:8000",
        "--noreload"
      ],
      "port": 8000
    },
    {
      "name": "koderkids-frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "frontend",
        "start"
      ],
      "port": 3000,
      "autoPort": true
    }
  ]
}